{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["vite.config.ts"]
}
